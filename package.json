{
  "name": "syncmirror",
  "version": "0.0.3",
  "homepage": "https://github.com/soybeanjs/syncmirror",
  "bugs": {
    "url": "https://github.com/soybeanjs/syncmirror/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/syncmirror.git"
  },
  "bin": {
    "syncmirror": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "commit": "soy git-commit",
    "fmt": "vp fmt",
    "lint": "vp lint . --fix",
    "prepare": "vp config --no-agent",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "cac": "7.1.0",
    "consola": "3.4.2",
    "kolorist": "1.8.0",
    "ofetch": "1.5.1"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.10.1"
}
